{
  "name": "@gradia64/dsh-i18n-it",
  "version": "0.3.0",
  "description": "Italian localization with automatic translation for the DeepSeek Harness Web UI",
  "type": "module",
  "main": "./index.mjs",
  "types": "./index.d.ts",
  "exports": {
    ".": {
      "types": "./index.d.ts",
      "default": "./index.mjs"
    },
    "./client": {
      "default": "./lib/client.js"
    },
    "./cordis.patch.yml": "./cordis.patch.yml",
    "./package.json": "./package.json"
  },
  "scripts": {
    "i18n:check": "node scripts/check.mjs",
    "i18n:build": "node scripts/assemble.mjs",
    "i18n:extract": "node scripts/extract.mjs",
    "i18n:migrate": "node scripts/migrate-locales.mjs",
    "verify:runtime": "node scripts/verify-runtime.mjs",
    "verify:peers": "node scripts/verify-peers.mjs",
    "test": "npm run verify:peers && npm run i18n:check && npm run i18n:build && npm run verify:runtime"
  },
  "dsh": {
    "manifestVersion": 1,
    "bundle": {
      "patch": "./cordis.patch.yml"
    },
    "client": {
      "inject": [
        "@deepseek-ai/dsh-client-connection",
        "@deepseek-ai/dsh-client-locale"
      ],
      "platform": "web"
    },
    "market": {
      "category": "ui",
      "description": {
        "en": "Adds Italian to the DeepSeek Harness Web UI, with hand-polished translations, English fallback for new strings, and automatic translation of market and third-party text.",
        "zh": "为 DeepSeek Harness 界面新增意大利语：逐条精译，新字串回退英文，另以自动翻译覆盖市场与第三方文本。"
      }
    }
  },
  "engines": {
    "dsh": ">=0.1.1-rc.2 <0.3.0-0",
    "node": "^22.19.0 || >=24.0.0"
  },
  "peerDependencies": {
    "@deepseek-ai/cordis": "^4.0.1",
    "@deepseek-ai/dsh-client-locale": ">=0.1.0-rc.6 <0.1.1 || >=0.1.1-rc.1 <0.2.0-0 || >=0.2.0-rc.1 <0.2.1 || >=0.2.1-rc.1 <0.3.0-0",
    "@deepseek-ai/dsh-llm": ">=0.1.0-rc.2 <0.1.1 || >=0.1.1-rc.1 <0.2.0-0 || >=0.2.0-rc.1 <0.2.1 || >=0.2.1-rc.1 <0.3.0-0",
    "@deepseek-ai/schemastery": "*"
  },
  "keywords": [
    "deepseek-harness",
    "dsh-plugin",
    "dsh",
    "i18n",
    "localization",
    "italian",
    "italiano"
  ],
  "files": [
    "index.mjs",
    "index.d.ts",
    "lib/client.js",
    "cordis.patch.yml",
    "README.md",
    "LICENSE",
    "scripts/locales.mjs"
  ],
  "license": "MIT",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/gradia64/dsh-i18n-it.git"
  },
  "homepage": "https://github.com/gradia64/dsh-i18n-it#readme",
  "bugs": {
    "url": "https://github.com/gradia64/dsh-i18n-it/issues"
  }
}
